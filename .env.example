# Server only. Never expose these to the client bundle.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

PRONUNCIATION_PROVIDER=azure
MAX_AUDIO_SECONDS=15
MIN_AUDIO_SECONDS=0.25
MIN_SNR_DB=10

MONGO_URL=mongodb://localhost:27017
MONGO_DB=sonare

# Optional. Unset = the #/diagnostics screen's read endpoints stay open (fine
# for local dev). Set this before the server is reachable outside a dev
# machine — visit #/diagnostics?token=<value> once, it's remembered after.
DIAGNOSTICS_TOKEN=
