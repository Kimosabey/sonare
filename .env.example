# Server only. Never expose these to the client bundle.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

PRONUNCIATION_PROVIDER=azure
MAX_AUDIO_SECONDS=15
MIN_AUDIO_SECONDS=0.25
MIN_SNR_DB=10

MONGO_URL=mongodb://localhost:27017
MONGO_DB=sonare

# Required to use the #/diagnostics screen's read endpoints — unset means
# they're disabled (fail closed), not open. Set it, then visit
# #/diagnostics?token=<value> once; it's remembered after.
DIAGNOSTICS_TOKEN=

# Optional. Total scoring calls allowed per UTC day, across all callers — a
# ceiling independent of the per-IP rate limit, since every scored attempt is
# a billed Azure API call.
MAX_DAILY_SCORING_CALLS=2000

# Optional. How long attempts/diagnostics records survive in MongoDB before
# a TTL index removes them automatically.
RETENTION_DAYS=90
