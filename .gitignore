node_modules/
dist/
dist-server/
build/
__pycache__/
*.pyc

# Never commit. .env.example is the committed template.
.env
.env.*
!.env.example
# *.env.* only catches a dot-prefixed name — a suffix-named credentials file
# (e.g. atlas-credentials.env, downloaded straight from a dashboard) slipped
# past this once already. Catch that shape too, anywhere in the tree.
*credentials*.env
*credentials*.json

.DS_Store
*.log

# Local test output
french-activity-test-results.json

# server/fallbackLog.ts's last-resort local copy of attempts/diagnostics
# records when MongoDB is unreachable — holds real learner data, never
# committed. Replay into Mongo with `npm run replay-fallback`.
#
# Unanchored on purpose. This was `/data/`, which matches only the repo root —
# FALLBACK_DIR is relative to process.cwd(), so running the server from
# server/ (or any older code path that wrote server/data/) produced a
# real-learner-data file that git happily offered to commit. Match the
# directory name at any depth instead.
data/

# Diagnostic learner audio from SAVE_AUDIO_DIR. Never committed.
audio-debug/
