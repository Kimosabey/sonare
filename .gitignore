# Never commit. .env.example is the committed template.
.env
.env.*
!.env.example
# *.env.* only catches a dot-prefixed name — a suffix-named credentials file
# (e.g. atlas-credentials.env, downloaded straight from a dashboard) slipped
# past this once already. Catch that shape too, anywhere in the tree.
*credentials*.env
*credentials*.json

.DS_Store
*.log

